# Copy to .env (never commit .env) and fill in.

PORT=3000
PUBLIC_URL=https://your-app.example.com

# AI model (leave empty to run in keyword-fallback mode)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Facebook Messenger (Meta for Developers > your app > Messenger)
FB_VERIFY_TOKEN=choose-any-random-string
FB_APP_SECRET=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v21.0

# true = only doctor-approved knowledge-base entries are used (required for real users)
APPROVED_ONLY=true

# Protects /api/stats?token=...
STATS_TOKEN=

# Password for the team results page (/results). Use a long random string. Share only with the team.
TEAM_TOKEN=

# Optional cloud database for tester feedback, interviews and usage counts (see db/schema.sql).
# Strongly recommended when hosted: free hosting wipes local files on restart.
# Use the service_role key: it stays on the server and is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
